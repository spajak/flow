{
    "name": "spajak/flow",
    "description": "Simple PHP application base",
    "type": "library",
    "license": "MIT",
    "authors": [{
        "name": "Sebastian Pająk",
        "email": "spconv@gmail.com"
    }],
    "autoload": {
        "psr-4": {
            "Flow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "psr/log": "^3.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "northwoods/broker": "^3.0",
        "symfony/console": "^8.0",
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.1",
        "php-di/invoker": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
